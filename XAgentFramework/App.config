    <add key="Model:Gemini31FlashLite:Group" value="gemini_api_key" />
    
    <add key="Model:Gemma31B:Name" value="Gemma 4 31B" />
    <add key="Model:Gemma31B:Url" value="https://generativelanguage.googleapis.com/v1beta/models/gemma-4-31b-it:generateContent" />
    <add key="Model:Gemma31B:Group" value="gemini_api_key" />

