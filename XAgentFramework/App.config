    <add key="Model:Gemini31FlashTTS:Group" value="gemini_api_key" />

    <add key="Model:Gemini3FlashLive:Name" value="Gemini 3 Flash Live" />
    <add key="Model:Gemini3FlashLive:Url" value="https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent" />
