<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>

    <add key="Model:GptOss120b:Name" value="openai/gpt-oss-120b" />
    <add key="Model:GptOss120b:Url" value="https://api.groq.com/openai/v1/" />
