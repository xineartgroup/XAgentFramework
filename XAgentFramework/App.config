    <add key="Model:Agenx:Group" value="agenx_api_key" />
    <add key="Model:Agenx:AutoPrompt" value="Used for:
         Getting the time - get time/get date/get datetime,
         File write operations - save file [{filepath}],
         File read operations - read file [{filepath}],
         Folder operations - list folders/files [{folderpath}],
         Sending mails - send mail [{title}] [{recipient(s)}] [{content}],
         Sending messages - send message [{recipient}] [{content}]" />

